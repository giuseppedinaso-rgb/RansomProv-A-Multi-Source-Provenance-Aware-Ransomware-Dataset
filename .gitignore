# Raw tracker dumps and intermediate files: regenerated by the pipeline
raw/*
!raw/.gitkeep
build/*
!build/.gitkeep
# Released data: kept out of the repository until all trackers grant permission
# to redistribute (see data/README.md). Remove these lines once permission is granted.
data/release_v1.0/events_*
data/release_v1.1/events_*
# Python, notebooks, logs, model artefacts
__pycache__/
*.pyc
.ipynb_checkpoints/
logs/
catboost_info/
lightning_logs/
*.ckpt
*.pt
.env
